@page
@model dynamic
@{
    ViewData["Title"] = "Menú";
}
<link href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,200..1000;1,200..1000&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Zen+Tokyo+Zoo&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Iceberg&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Gowun+Dodum&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet">

<!-- Sección de bienvenida -->
<section class="hero-sobreNosotros" style="background-image: url('/images/Menu.jpg'); background-size: cover;">
    <div class="overlay">
        <h1 class="hero-sobreNosotros">NUESTRO MENÚ</h1>
    </div>
</section>

<!-- Filtros de productos -->
<div class="text-center my-4">
    <button class="btn btn-outline-dark filtro-btn active" data-filtro="todos">Todos</button>
    <button class="btn btn-outline-dark filtro-btn" data-filtro="frio">Café frío</button>
    <button class="btn btn-outline-dark filtro-btn" data-filtro="caliente">Café caliente</button>
    <button class="btn btn-outline-dark filtro-btn" data-filtro="horneado">Horneados</button>
</div>

<!-- Sección de Productos -->
<section class="container productos">
    <h2 class="text-center mb-4">NUESTROS PRODUCTOS</h2>
    <div class="row">
        <div class="col-md-4 mb-4 producto-item caliente">
            <div class="producto-card">
                <img src="~/images/TazaCafe.png" class="producto-img" alt="Café Espresso">
                <div class="producto-desc">Intenso y aromático, preparado con granos seleccionados.<br>$6.000 COP
                </div>
                <div class="producto-nombre">Café Espresso</div>
            </div>
        </div>
        <div class="col-md-4 mb-4 producto-item caliente">
            <div class="producto-card">
                <img src="~/images/Latte.png" class="producto-img" alt="Latte">
                <div class="producto-desc">Espuma cremosa y sabor suave, ideal para cualquier momento.<br>$7.500 COP
                </div>
                <div class="producto-nombre">Latte</div>
            </div>
        </div>
        <div class="col-md-4 mb-4 producto-item frio">
            <div class="producto-card">
                <img src="~/images/Malteada.png" class="producto-img" alt="Malteada">
                <div class="producto-desc">El postre perfecto para acompañar tu café favorito.<br>$9.000 COP
                </div>
                <div class="producto-nombre">Malteada</div>
            </div>
        </div>
        <div class="col-md-4 mb-4 producto-item frio">
            <div class="producto-card">
                <img src="~/images/Frappuccino.png" class="producto-img" alt="Frappuccino">
                <div class="producto-desc">Refrescante café frío con hielo y crema batida.<br>$10.000 COP
                </div>
                <div class="producto-nombre">Frappuccino</div>
            </div>
        </div>
        <div class="col-md-4 mb-4 producto-item horneado">
            <div class="producto-card">
                <img src="~/images/Croissant.png" class="producto-img" alt="Croissant">
                <div class="producto-desc">Horneado cada mañana, perfecto para acompañar tu café.<br>$5.500 COP
                </div>
                <div class="producto-nombre">Croissant</div>
            </div>
        </div>
        <div class="col-md-4 mb-4 producto-item frio">
            <div class="producto-card">
                <img src="~/images/SodaSaborizada.png" class="producto-img" alt="SodaSaborizada">
                <div class="producto-desc">Bebida burbujeante con un toque dulce y ácido de frutas del bosque.<br>$7.000 COP
                </div>
                <div class="producto-nombre">Soda Saborizada</div>
            </div>
        </div>
        <div class="col-md-4 mb-4 producto-item caliente">
            <div class="producto-card">
                <img src="~/images/Mocchiato.png" class="producto-img" alt="Mocchiato">
                <div class="producto-desc">Espresso intenso suavizado con una delicada capa de leche espumada.<br>$7.000 COP
                </div>
                <div class="producto-nombre">Mocchiato</div>
            </div>
        </div>
        <div class="col-md-4 mb-4 producto-item horneado">
            <div class="producto-card">
                <img src="~/images/PanDeQueso.png" class="producto-img" alt="Pan de Queso">
                <div class="producto-desc">Delicioso panecillo horneado con queso fundido.<br>$4.500 COP
                </div>
                <div class="producto-nombre">Pan de Queso</div>
            </div>
        </div>
        <div class="col-md-4 mb-4 producto-item frio">
            <div class="producto-card">
                <img src="~/images/Limonada.png" class="producto-img" alt="Limonada">
                <div class="producto-desc">Refrescante mezcla de jugo de limón natural con un toque de dulzor.<br>$6.500 COP
                </div>
                <div class="producto-nombre">Limonada</div>
            </div>
        </div>
        <div class="col-md-4 mb-4 producto-item horneado">
            <div class="producto-card">
                <img src="~/images/Almohabana.png" class="producto-img" alt="Almohabana">
                <div class="producto-desc">Panecillo suave y esponjoso hecho con queso y almidón de yuca.<br>$4.500 COP
                </div>
                <div class="producto-nombre">Almohabana</div>
            </div>
        </div>
        <div class="col-md-4 mb-4 producto-item caliente">
            <div class="producto-card">
                <img src="~/images/Chocolate.png" class="producto-img" alt="Chocolate">
                <div class="producto-desc">Bebida cremosa y reconfortante hecha con chocolate derretido.<br>$6.500 COP
                </div>
                <div class="producto-nombre">Chocolate</div>
            </div>
        </div>
        <div class="col-md-4 mb-4 producto-item horneado">
            <div class="producto-card">
                <img src="~/images/Muffin.png" class="producto-img" alt="Muffin">
                <div class="producto-desc">Bizcocho individual suave y esponjoso, ideal para acompañar el café.<br>5.000 COP
                </div>
                <div class="producto-nombre">Muffin</div>
            </div>
        </div>
    </div>
</section>

<script>
    // Script para filtrar productos
    document.querySelectorAll('.filtro-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.filtro-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            const filtro = this.getAttribute('data-filtro');
            document.querySelectorAll('.producto-item').forEach(item => {
                if (filtro === 'todos' || item.classList.contains(filtro)) {
                    item.style.display = '';
                } else {
                    item.style.display = 'none';
                }
            });
        });
    });
</script>
