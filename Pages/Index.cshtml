@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Café Gatsby</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Cafeteria.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,200..1000;1,200..1000&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Zen+Tokyo+Zoo&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Iceberg&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Gowun+Dodum&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet">


</head>
<body>
    <!-- Sección de bienvenida -->
    <section class="hero-bienvenida" style="background-image: url('https://dmlxzvnzyohme.cloudfront.net/2013/04/_1200xAUTO_crop_center-center_none_ns/coffee-and-beans.jpg');background-size: cover; ">
        <div class="overlay" style="margin: 0; padding: 0;">
            <h1>CAFÉ GATSBY</h1>
        </div>
    </section>

<!-- Sobre Nosotros -->
<section class="container-fluid sobreNosotros py-5">
    <div class="row align-items-center">
        <div class="col-md-6 sobreNosotrosTxt px-5">
            <h2>Sobre Nosotros</h2>
            <p>Café Gatsby es una cafetería inspirada en los años 20 y el mundo de El Gran Gatsby, que combina el aroma del café con el lujo del jazz y la estética art déco. Su ambiente elegante, con detalles dorados y mobiliario vintage, ofrece una experiencia envolvente. La carta incluye cafés especiales, repostería artesanal y cócteles sin alcohol, evocando la sofisticación de una época dorada. Más que una cafetería, es un viaje nostálgico lleno de encanto, música y nuevos comienzos.</p>
            <a href="/SobreNosotros" class="btn btn-custom mt-3">CONÓCENOS</a>
        </div>
        <div class="col-md-6 text-center position-relative">                
            <div class="img-conocenos">
                <img src="~/images/Conocenos.jpg" class="img-fluid rounded img-conocenos" alt="Cafetería">
                <div class="circle-label">
                    <span id="circle-number">1</span>
                    <span id="circle-text" style="display:none; margin-left: 2px; font-size: 1rem">Años</span>
                </div>
            </div>                
        </div>
    </div>
</section>

<!-- Productos destacados -->
<section class="container my-5 productos">
    <h2 class="text-center mb-4">PRODUCTOS DESTACADOS</h2>
    <div class="row">
        <div class="col-md-4 mb-4">
            <a href="/Menu" style="text-decoration:none; color:inherit;">
                <div class="producto-card">
                    <img src="~/images/TazaCafe.png" class="producto-img" alt="Café Espresso">
                    <div class="producto-desc">Intenso y aromático, preparado con granos seleccionados.</div>
                    <div class="producto-nombre">Café Espresso</div>
                </div>
            </a>
        </div>
        <div class="col-md-4 mb-4">
            <a href="/Menu" style="text-decoration:none; color:inherit;">
                <div class="producto-card">
                    <img src="~/images/Latte.png" class="producto-img" alt="Latte">
                    <div class="producto-desc">Espuma cremosa y sabor suave, ideal para cualquier momento.</div>
                    <div class="producto-nombre">Latte</div>
                </div>
            </a>
        </div>
        <div class="col-md-4 mb-4">
            <a href="/Menu" style="text-decoration:none; color:inherit;">
                <div class="producto-card">
                    <img src="~/images/Malteada.png" class="producto-img" alt="Malteada">
                    <div class="producto-desc">El postre perfecto para acompañar tu café favorito.</div>
                    <div class="producto-nombre">Malteada</div>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- Separador visual -->
<section class="separador-rectangular">
    <img src="~/images/Separador.jpg" alt="Separador" style="width:100%; display:block; max-height:120px; object-fit:cover;">
</section>

<!-- Ubicación -->
<section class="ubicacion-section">
    <div class="row align-items-center justify-content-center m-0">
        <div class="col-md-5 text-white ubicacion-texto py-4">
            <h2 class="mb-4">UBICACIÓN</h2>
            <p>¡Ven a visitarnos y disfruta de la mejor experiencia de café en la ciudad! Estamos ubicados en el corazón de El Poblado, Medellín, rodeados de un ambiente único y acogedor.</p>
            <p><strong>Dirección:</strong> Calle Principal 123, El Poblado, Medellín</p>
            <p><strong>Horario:</strong> Lunes a Sábado 8:00am - 8:00pm</p>
        </div>
        <div class="col-md-7 d-flex justify-content-center py-4">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.4114972119046!2d-75.57026799065017!3d6.2093316437525585!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e4428299b5aa6d9%3A0x2020c055ff96b671!2sEl%20Poblado%2C%20Medell%C3%ADn%2C%20El%20Poblado%2C%20Medell%C3%ADn%2C%20Antioquia!5e0!3m2!1ses!2sco!4v1745975873191!5m2!1ses!2sco" width="400" height="300" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
    </div>
</section>

<script>
let current = 1;
const max = 5;
const span = document.getElementById('circle-number');
const text = document.getElementById('circle-text');
let animationStarted = false;

function animateCircleNumber() {
    if (current <= max) {
        span.textContent = current;
        current++;
        setTimeout(animateCircleNumber, 200);
    } else {
        text.style.display = "inline";
    }
}

const observer = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
        if (entry.isIntersecting && !animationStarted) {
            animationStarted = true;
            animateCircleNumber();
            observer.unobserve(entry.target);
        }
    });
}, { threshold: 0.5 });

observer.observe(span);
</script></body>
</html>
