        <div class="personal-card">
          <img src="/images/Estilo.png" class="personal-img" alt="Encargada de Estilo & Ambientación">
          <div class="personal-nombre">Encargada de Estilo & Ambientación<br>Sofía Londoño</div>
          <div class="personal-desc">Responsable de la decoración y el diseño del espacio, Sofía transforma cada rincón en una postal de los años 20, manteniendo viva la estética art déco que distingue a Café Gatsby.</div>
        </div>
      </div>
      <button class="personal-arrow" id="nextPersonal">&#8594;</button>
    </div>

    <div class="personal-indicators">
    <span class="indicator-dot"></span>
    <span class="indicator-dot"></span>
    <span class="indicator-dot active"></span>
    <span class="indicator-dot"></span>
    <span class="indicator-dot"></span>
  <!-- ... una por cada carta ... -->
</div>

  </div>
</section>

<style>
  #personalSlider .card {
    transition: transform 0.6s ease, opacity 0.6s ease;
    opacity: 0.5;
    transform: scale(0.8);
    display: none;
  }

  #personalSlider .center {
    opacity: 1 !important;
    transform: scale(1.15) !important;
    z-index: 2;
  }
</style>

<script>
const slider = document.getElementById('personalSlider');
let cards = Array.from(slider.children);
let total = cards.length;
let centerIndex = 1;

function renderSlider() {
  cards.forEach((card, index) => {
    card.classList.remove('center');
    card.style.display = 'none';
    card.style.opacity = '0.5';
    card.style.transform = 'scale(0.8) translateX(0)';
  });

  const showCard = (index, offset = 0) => {
    if (index >= 0 && index < total) {
      cards[index].style.display = 'flex';
      cards[index].style.transform = `scale(0.8) translateX(${offset}%)`;
    }
  };

  showCard(centerIndex - 1, -100);
  showCard(centerIndex + 1, 100);

  const centerCard = cards[centerIndex];
  centerCard.style.display = 'flex';
  centerCard.classList.add('center');
  centerCard.style.transform = 'scale(1.15) translateX(0)';
  centerCard.style.opacity = '1';

  document.getElementById('prevPersonal').disabled = centerIndex === 0;
  document.getElementById('nextPersonal').disabled = centerIndex === total - 1;

  // --- NUEVO: Actualizar los indicadores ---
  const dots = document.querySelectorAll('.indicator-dot');
  dots.forEach((dot, idx) => {
    if (idx === centerIndex) {
      dot.classList.add('active');
    } else {
      dot.classList.remove('active');
    }
  });
}

function animateSlider(direction) {
  const offset = direction === 'left' ? -100 : 100;

  cards.forEach((card, index) => {
    if (card.style.display === 'flex') {
      card.style.transform += ` translateX(${offset}%)`;
    }
  });

  setTimeout(() => {
    renderSlider();
  }, 400);
}

document.getElementById('prevPersonal').onclick = () => {
  if (centerIndex > 0) {
    centerIndex--;
    animateSlider('right');
  }
};

document.getElementById('nextPersonal').onclick = () => {
  if (centerIndex < total - 1) {
    centerIndex++;
    animateSlider('left');
  }
};

renderSlider();
</script>

<!-- Sección Trabaja con Nosotros -->
<section class="trabaja-nosotros-section">
  <div class="container">
    <h2 class="text-center" style="color: #b71c1c; font-family: 'Iceberg', sans-serif; margin-bottom: 32px;">Trabaja con Nosotros</h2>
    <form class="trabaja-form" method="post" action="#" enctype="multipart/form-data">
      <div class="row">
        <div class="col-md-6 col-12">
          <div class="mb-3">
            <label for="nombre" class="form-label">Nombre completo</label>
            <input type="text" class="form-control" id="nombre" name="nombre" required>
          </div>
          <div class="mb-3">
            <label for="email" class="form-label">Correo electrónico</label>
            <input type="email" class="form-control" id="email" name="email" required>
          </div>
          <div class="mb-3">
            <label for="telefono" class="form-label">Teléfono</label>
            <input type="tel" class="form-control" id="telefono" name="telefono">
          </div>
        </div>
        <div class="col-md-6 col-12 d-flex flex-column justify-content-between">
          <div class="mb-3">
            <label for="cv" class="form-label">Sube tu hoja de vida (PDF)</label>
            <input type="file" class="form-control" id="cv" name="cv" accept="application/pdf" required>
          </div>
          <div class="mb-3 flex-grow-1 d-flex flex-column">
            <label for="mensaje" class="form-label">Cuéntanos por qué quieres trabajar con nosotros</label>
            <textarea class="form-control" id="mensaje" name="mensaje" rows="4" required></textarea>
          </div>
        </div>
      </div>
      <div class="text-center">
        <button type="submit" class="btn btn-custom" id="btnEnviarSolicitud">Enviar Solicitud</button>
      </div>
    </form>
  </div>
</section>
<script>
  // Evento para mostrar mensaje al enviar solicitud
  document.getElementById('btnEnviarSolicitud').addEventListener('click', function(e) {
    e.preventDefault();
    alert('¡Su solicitud ha sido enviada!');
  });
</script>


