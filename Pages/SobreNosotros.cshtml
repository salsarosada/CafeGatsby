<!-- Sección de bienvenida -->
<section class="hero-sobreNosotros" style="background-image: url('/images/SobreNosotros.png'); background-size: cover;">
    <div class="overlay">
        <h1 class="hero-sobreNosotros">SOBRE NOSOTROS</h1>
    </div>
</section>

<!-- Sección principal de sobre nosotros -->
<section class="container-fluid sobreNosotros py-5">
    <div class="row align-items-center">
        <div class="col-md-6 sobreNosotrosTxt px-5">
            <h2>Sobre Nosotros</h2>
            <p>
                En Café Gatsby, creemos que cada taza de café merece una historia. Inspirados en el glamour de los años 20 y la elegancia de la era art déco, hemos creado un espacio donde la sofisticación del pasado se fusiona con los sabores del presente.<br>

                Más que una cafetería, somos una experiencia sensorial. Desde nuestros granos de café seleccionados hasta la ambientación cuidadosamente diseñada, buscamos que cada visita te transporte a un tiempo donde el jazz llenaba el aire y los sueños parecían al alcance de una copa.
            </p>
        </div>
        <div class="col-md-6 text-center position-relative">
            <div class="img-conocenos">
                <img src="~/images/Conocenos.jpg" class="img-fluid rounded img-conocenos" alt="Conócenos">
                <div class="circle-label">
                    <span id="circle-number">1</span>
                    <span id="circle-text" style="display:none; margin-left: 2px; font-size: 1rem">Años</span>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    let current = 1;
    const max = 5;
    const span = document.getElementById('circle-number');
    const text = document.getElementById('circle-text');
    let animationStarted = false;

    function animateCircleNumber() {
        if (current <= max) {
            span.textContent = current;
            current++;
            setTimeout(animateCircleNumber, 200);
        } else {
            text.style.display = "inline";
        }
    }

    const observer = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
            if (entry.isIntersecting && !animationStarted) {
                animationStarted = true;
                animateCircleNumber();
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.5 });

    observer.observe(span);
</script>

<!-- Sección Nuestro Personal -->
<section class="nuestro-personal-section">
  <div class="container">
    <h2 class="nuestro-personal-title">Nuestro Personal</h2>
    <div class="personal-slider-container">
      <button class="personal-arrow" id="prevPersonal">&#8592;</button>
      <div class="personal-slider" id="personalSlider">
